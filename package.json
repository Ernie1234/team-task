{
  "name": "team-task",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@team-task/api",
    "dev:web": "turbo run dev --filter=@team-task/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "^2.11.13"
  },
  "overrides": {
    "@types/express-serve-static-core": "5.0.7"
  }
}
